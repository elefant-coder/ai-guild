{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/elefant-coder/ai-guild/docs/guild.config.schema.json",
  "title": "AI Guild configuration",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "language": { "type": "string", "pattern": "^[a-z]{2}$", "description": "Locale file to use (src/locales/<code>.json)." },
    "guild": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "tagline": { "type": "string", "maxLength": 120 },
        "description": { "type": "string", "maxLength": 200 }
      },
      "required": ["name"]
    },
    "player": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 40 },
        "avatar": { "type": "string", "description": "Path under public/, e.g. /art/player.webp" }
      }
    },
    "timezone": { "type": "string", "description": "IANA zone used for day buckets and clock display." },
    "machines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]{1,32}$" },
          "label": { "type": "string", "minLength": 1, "maxLength": 40 },
          "kind": { "enum": ["local", "ssh"] },
          "host": { "type": "string", "description": "ssh alias, for kind=ssh" }
        },
        "required": ["id", "label", "kind"]
      }
    },
    "theme": {
      "type": "object",
      "properties": {
        "preset": { "type": "string" },
        "colors": {
          "type": "object",
          "propertyNames": { "enum": ["ink", "muted", "paper", "surface", "surface2", "line", "accent", "accentDark", "warm", "gold", "edge", "shadow"] },
          "additionalProperties": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
        },
        "font": { "type": "string" },
        "darkPanel": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
      }
    },
    "art": {
      "type": "object",
      "properties": {
        "style": { "type": "string" },
        "characterConcept": { "type": "string" },
        "subjects": { "type": "array", "items": { "type": "string" } },
        "toolStyle": { "type": "string" },
        "constraints": { "type": "string" },
        "provider": { "enum": ["manual", "codex-cli"] },
        "dailyLimit": { "type": "integer", "minimum": 0, "maximum": 50 }
      }
    },
    "agents": {
      "type": "object",
      "properties": { "featured": { "type": "array", "items": { "type": "string" }, "maxItems": 12 } }
    },
    "roles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "maxLength": 60 },
          "strengths": { "type": "array", "items": { "type": "string", "maxLength": 60 }, "maxItems": 6 },
          "exampleTask": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "brands": { "type": "object", "additionalProperties": { "type": "string" }, "description": "substring in item id/name → brand key" },
    "collector": {
      "type": "object",
      "properties": {
        "roots": {
          "type": "object",
          "properties": { "claude": { "type": "string" }, "codex": { "type": "string" }, "sharedSkills": { "type": "string" } }
        },
        "projectRoots": { "type": "array", "items": { "type": "string" } },
        "clis": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" } },
        "jobs": {
          "type": "object",
          "properties": {
            "includePatterns": { "type": "array", "items": { "type": "string" } },
            "excludePatterns": { "type": "array", "items": { "type": "string" } },
            "privatePatterns": { "type": "array", "items": { "type": "string" } }
          }
        },
        "usage": {
          "type": "object",
          "properties": { "providers": { "type": "array", "items": { "enum": ["codex", "claude"] } } }
        }
      }
    },
    "sync": {
      "type": "object",
      "properties": {
        "endpoint": { "type": "string" },
        "staleAfterSeconds": { "type": "integer", "minimum": 60, "maximum": 86400 }
      }
    }
  },
  "required": ["language", "guild", "machines"]
}
